+#[test]
+fn historical_strong_receipt_replay_is_exact_but_new_acknowledgment_is_fenced() {
+    let mut legacy = setup();
+    let mut scoped = legacy.clone();
+    let initial_receipts = legacy.snapshot().receipts.clone();
+    let mut claim = new_claim(100);
+    let receipt = &mut claim.validations[0].content;
+    receipt.quality_bar = Some("Historical ignored quality requirement".into());
+    receipt.handlers = vec![
+        HandlerRef {
+            id: ValidatorId::from_u128(1),
+            version: ContentHash([1; 32]),
+            agentic: false,
+        },
+        HandlerRef {
+            id: ValidatorId::from_u128(2),
+            version: ContentHash([2; 32]),
+            agentic: true,
+        },
+    ];
+    receipt.evidence_schemas.insert(ContentHash([9; 32]));
+    claim.content.requirements[0].specification = receipt.specification_hash().unwrap();
+    let id = claim.id;
+    let receipt = ReceiptFence {
+        receipt: ReceiptId::from_u128(100),
+        epoch: 1,
+    };
+    let testament = TestamentId::from_u128(104);
+    let evidence_set = EvidenceSetId::from_u128(103);
+    let commands = [
+        (ISSUER, Command::GenerateClaim { claim }),
+        (ISSUER, Command::PostClaim { claim: id }),
+        (
+            WORKER,
+            Command::AcquireReceipt {
+                claim: id,
+                receipt: receipt.receipt,
+                epoch: 1,
+            },
+        ),
+        (
+            WORKER,
+            Command::BeginEvidenceSet {
+                claim: id,
+                receipt,
+                evidence_set,
+            },
+        ),
+        (
+            WORKER,
+            Command::CloseTestament {
+                claim: id,
+                receipt,
+                testament,
+                evidence_set,
+                manifest: vec![],
+                summary: "old close".into(),
+                confidence: Confidence::Committed,
+                outcome: OutcomeKind::Complete,
+            },
+        ),
+        (
+            ISSUER,
+            Command::AcknowledgeTestament {
+                claim: id,
+                testament,
+            },
+        ),
+        (ISSUER, Command::BeginWholeWorkValidation { claim: id }),
+        (ISSUER, Command::CompleteWholeWork { claim: id }),
+    ];
+    for (offset, (actor, command)) in commands.into_iter().enumerate() {
+        let guarded = matches!(
+            command,
+            Command::GenerateClaim { .. }
+                | Command::AcknowledgeTestament { .. }
+                | Command::BeginWholeWorkValidation { .. }
+                | Command::CompleteWholeWork { .. }
+        );
+        let ordinary = input(1000 + offset as u128, actor, command);
+        let scoped_input = managed(ordinary.clone());
+        if guarded {
+            assert!(matches!(
+                legacy.prepare(&ordinary),
+                Err(DomainOutcome::Refuse {
+                    code: ErrorCode::InvalidSchema,
+                    ..
+                })
+            ));
+            assert!(matches!(
+                scoped.stage_managed_pending_bounded(&PendingState::new(), &scoped_input, BYTES),
+                Err(StagingError::Domain(DomainOutcome::Refuse {
+                    code: ErrorCode::InvalidSchema,
+                    ..
+                }))
+            ));
+        }
+        // Construct the exact prior-format prepared intent, with the real
+        // canonical hash. Its historical reducer remains the recovery oracle.
+        let prepared = PreparedMutation {
+            schema: SCHEMA_MAJOR,
+            base: legacy.sequence(),
+            command_hash: command_hash(&ordinary).unwrap(),
+            input: ordinary.clone(),
+            footprint: Footprint {
+                ledger: ledger(),
+                session_exclusive: true,
+            },
+        };
+        let bytes = postcard::to_stdvec(&prepared).unwrap();
+        let prepared = postcard::from_bytes(&bytes).unwrap();
+        let old = legacy
+            .apply(SessionSeq(legacy.sequence().0 + 1), prepared)
+            .unwrap();
+        let prepared = PreparedManagedMutation {
+            schema: MANAGED_REQUEST_SCHEMA,
+            base: scoped.sequence(),
+            command_hash: managed_command_hash(&scoped_input).unwrap(),
+            input: scoped_input,
+            footprint: Footprint {
+                ledger: ledger(),
+                session_exclusive: true,
+            },
+        };
+        let bytes = postcard::to_stdvec(&prepared).unwrap();
+        let prepared = postcard::from_bytes(&bytes).unwrap();
+        let staged = scoped.replay_managed_bounded(&prepared, BYTES).unwrap();
+        scoped
+            .audit_managed_pending_stage(&PendingState::new(), &staged, BYTES)
+            .unwrap();
+        let result = scoped.publish_managed(staged).unwrap();
+        assert_eq!(result.outcome, old.receipt.outcome);
+        assert_eq!(result.deltas, old.deltas);
+        assert_eq!(result.effects, old.effects);
+        assert!(matches!(
+            legacy.prepare(&ordinary),
+            Err(DomainOutcome::Duplicate(_))
+        ));
+        let mut expected = legacy.snapshot().clone();
+        expected.receipts = initial_receipts.clone();
+        assert_eq!(&expected, scoped.snapshot());
+        legacy = Core::decode_checkpoint(&legacy.encode_checkpoint().unwrap()).unwrap();
+        scoped = Core::decode_checkpoint(&scoped.encode_checkpoint().unwrap()).unwrap();
+    }
+    // Historical committed Pass is preserved; recovery cannot revise old truth.
+    assert_eq!(
+        legacy.snapshot().claims[&id].lifecycle().status,
+        ClaimStatus::Satisfied
+    );
+    assert_eq!(
+        scoped.snapshot().claims[&id].lifecycle().status,
+        ClaimStatus::Satisfied
+    );
+}
