+    apply(&mut core, attachment(8104, b"observed proof"));
+    let observed = core.snapshot().evidence_sets[&set].artifacts.clone();
+    let manifest = manifest_hash(&observed).unwrap();
+    let target = observed[0].hash;
+    let revision = core.snapshot().claims[&id].lifecycle().revision;
+    let mut pending = PendingState::new();
+    pending.reserve(2).unwrap();
+    let staged = core
