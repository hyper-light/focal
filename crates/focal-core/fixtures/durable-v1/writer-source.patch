+#[test]
+fn new_receipt_requirements_cannot_silently_require_quality_or_schema() {
+    let mut core = setup();
+    let predecessor = new_claim(90);
+    let predecessor_id = predecessor.id;
+    apply(
+        &mut core,
+        input(90, ISSUER, Command::GenerateClaim { claim: predecessor }),
+    );
+    let before = core.normalized_bytes().unwrap();
+    for field in 0..3 {
+        let mut claim = new_claim(100);
+        edge(&mut claim, RelationKind::Supersedes, predecessor_id);
+        let receipt = &mut claim.validations[0].content;
+        match field {
+            0 => {
+                receipt.quality_bar = Some("Prove correctness".into());
+                receipt.handlers = vec![
+                    HandlerRef {
+                        id: ValidatorId::from_u128(1),
+                        version: ContentHash([1; 32]),
+                        agentic: false,
+                    },
+                    HandlerRef {
+                        id: ValidatorId::from_u128(2),
+                        version: ContentHash([2; 32]),
+                        agentic: true,
+                    },
+                ];
+            }
+            1 => receipt.handlers.push(HandlerRef {
+                id: ValidatorId::from_u128(1),
+                version: ContentHash([1; 32]),
+                agentic: false,
+            }),
+            _ => {
+                receipt.evidence_schemas.insert(ContentHash([9; 32]));
+            }
+        }
+        claim.content.requirements[0].specification = receipt.specification_hash().unwrap();
+        for command in [
+            Command::GenerateClaim {
+                claim: claim.clone(),
+            },
+            Command::GenerateClaimBatch {
+                claims: vec![claim.clone()],
+            },
+            Command::SupersedeClaim {
+                predecessor: predecessor_id,
+                successor: claim,
+            },
+        ] {
+            let command = input(100, ISSUER, command);
+            assert_eq!(
+                outcome_code(core.prepare(&command).unwrap_err()),
+                ErrorCode::InvalidSchema
+            );
+            assert!(matches!(
+                core.stage_pending_bounded(&PendingState::new(), &command, 16 * 1024 * 1024),
+                Err(StagingError::Domain(DomainOutcome::Refuse {
+                    code: ErrorCode::InvalidSchema,
+                    ..
+                }))
+            ));
+            let managed = ManagedAuthenticatedInput {
+                key: ManagedRequestKey {
+                    stream: RequestStreamIdentity {
+                        cluster: [9; 16],
+                        ledger: ledger(),
+                        principal: ISSUER,
+                        slot: 0,
+                        generation: 1,
+                    },
+                    ordinal: 1,
+                    id: command.request_id,
+                },
+                expected_revision: command.expected_revision,
+                authority: command.authority,
+                command: command.command,
+            };
+            assert!(matches!(
+                core.stage_managed_pending_bounded(
+                    &PendingState::new(),
+                    &managed,
+                    16 * 1024 * 1024
+                ),
+                Err(StagingError::Domain(DomainOutcome::Refuse {
+                    code: ErrorCode::InvalidSchema,
+                    ..
+                }))
+            ));
+            assert_eq!(core.normalized_bytes().unwrap(), before);
+        }
+    }
+    let mut successor = new_claim(100);
+    edge(&mut successor, RelationKind::Supersedes, predecessor_id);
+    apply(
+        &mut core,
+        input(
+            100,
+            ISSUER,
+            Command::SupersedeClaim {
+                predecessor: predecessor_id,
+                successor,
+            },
+        ),
+    );
+    assert_eq!(
+        core.snapshot().claims[&predecessor_id].lifecycle().status,
+        ClaimStatus::Superseded
+    );
+    assert_eq!(
+        core.snapshot().claims[&ClaimId::from_u128(100)]
+            .lifecycle()
+            .status,
+        ClaimStatus::Generated
+    );
+}
